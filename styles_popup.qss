QDialog#popupDialog {
    background: transparent;
}

#popupCard {
    background: #FFFFFF;
    border-radius: 24px;
}

#popupContent,
#popupFooter {
    background: transparent;
}

#popupTitle {
    font-size: 26px;
    font-weight: 700;
    color: #0F0F10;
}

#popupSubtitle {
    font-size: 15px;
    color: #5B6B8C;
}

#popupSeparator {
    background: #3A3A3A;
}

#popupClose {
    background: transparent;
    border: none;
    border-radius: 10px;
}

#popupClose:hover {
    background: #EEF1F7;
}

QScrollArea#popupScroll {
    background: transparent;
    border: none;
    padding: 0 25px 0 0;
}

QScrollArea#popupScroll QScrollBar:vertical {
    background: transparent;
    width: 16px;
    margin: 84px 0 12px 0;
}

QScrollArea#popupScroll QScrollBar::add-page:vertical,
QScrollArea#popupScroll QScrollBar::sub-page:vertical {
    background: #EDEDED;
    margin: 0 5px;
}

QScrollArea#popupScroll QScrollBar::handle:vertical {
    background: #D3D3D3;
    border-radius: 0;
    min-height: 40px;
}

QScrollArea#popupScroll QScrollBar::add-line:vertical,
QScrollArea#popupScroll QScrollBar::sub-line:vertical {
    height: 0;
    background: transparent;
}

#sectionTitle {
    font-size: 15px;
    font-weight: 700;
    color: #0F0F10;
}

#sectionHint {
    font-size: 14px;
    color: #5B6B8C;
}

#modelCard {
    background: #FFFFFF;
    border: 2px solid transparent;
    border-radius: 16px;
}

#modelCard:hover {
    background: #FAFBFE;
}

#modelCard[selected="true"] {
    background: #F5F8FF;
    border: 2px solid #3461FF;
}

#modelCardTitle {
    font-size: 15px;
    font-weight: 700;
    color: #0F0F10;
    background: transparent;
}

#modelCardDesc {
    font-size: 14px;
    color: #171717;
    background: transparent;
}

QComboBox#algorithmCombo {
    background: #FFFFFF;
    border: 1px solid #C9CED8;
    border-radius: 8px;
    padding: 0 12px;
    min-height: 40px;
    font-size: 14px;
    color: #171717;
}

QComboBox#algorithmCombo:focus {
    border: 1px solid #3461FF;
}

QComboBox#algorithmCombo::drop-down {
    border: none;
    width: 36px;
}

QComboBox#algorithmCombo QAbstractItemView {
    background: #FFFFFF;
    color: #171717;
    border: 1px solid #C9CED8;
    selection-background-color: #E6EDFB;
    selection-color: #171717;
    outline: none;
}

#infoBox {
    background: #E6EDFB;
    border-radius: 16px;
}

#infoText {
    font-size: 14px;
    color: #171717;
    background: transparent;
}

#tableHeaderCell {
    font-size: 15px;
    font-weight: 700;
    color: #0F0F10;
    background: #FFFFFF;
    border: 1px solid #DDE1EA;
    border-right: none;
}

#tableHeaderCell[last="true"] {
    border-right: 1px solid #DDE1EA;
}

#paramPurpose,
#paramName,
#paramType {
    font-size: 14px;
    color: #171717;
    background: transparent;
}

#paramAllowed {
    font-size: 14px;
    color: #6B7894;
    background: transparent;
}

QLineEdit#paramInput {
    background: #FFFFFF;
    border: 1px solid #D3D8E0;
    border-radius: 6px;
    padding: 0 10px;
    min-height: 34px;
    font-size: 14px;
    color: #171717;
    placeholder-text-color: #9AA3B5;
}

QLineEdit#paramInput:focus {
    border: 1px solid #3461FF;
}

QLineEdit#paramInput[invalid="true"] {
    background: #FFF5F5;
    border: 1px solid #E5484D;
}

#secondaryButton {
    background: #E8ECF4;
    color: #171717;
    border: none;
    border-radius: 14px;
    font-size: 16px;
    padding: 0 28px;
}

#secondaryButton:hover {
    background: #DDE3EF;
}
