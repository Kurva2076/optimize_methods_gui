#brandTitle {
    font-size: 20px;
    font-weight: 600;
    color: #171717;
}

#brandSubtitle {
    font-size: 12px;
    color: #171717;
}

#screenTitle {
    font-size: 20px;
    font-weight: 700;
    color: #171717;
}

#screenSubtitle {
    font-size: 14px;
    color: #6B5A5F;
}

#stepCircle {
    background: #DCDDE0;
    color: #2B2B2B;
    border-radius: 20px;
    font-size: 15px;
}

#stepCircle[active="true"] {
    background: #3461FF;
    color: #FFFFFF;
}

#stepLabel {
    background: transparent;
    color: #171717;
    font-size: 14px;
}

#stepLabel[active="true"] {
    font-weight: 600;
}

#stepLine {
    background: #DDE1EA;
}