#brandTitle {
    font-size: 20px;
    font-weight: 600;
    color: #171717;
}

#brandSubtitle {
    font-size: 12px;
    color: #171717;
}

#screenTitle {
    font-size: 20px;
    font-weight: 700;
    color: #171717;
}

#screenSubtitle {
    font-size: 14px;
    color: #6B5A5F;
}

#stepCircle {
    background: #DCDDE0;
    color: #2B2B2B;
    border-radius: 20px;
    font-size: 15px;
}

#stepCircle[active="true"] {
    background: #3461FF;
    color: #FFFFFF;
}

#stepLabel {
    background: transparent;
    color: #171717;
    font-size: 14px;
}

#stepLabel[active="true"] {
    font-weight: 600;
}

#stepLine {
    background: #DDE1EA;
}

#modelCard {
    background: #FFFFFF;
    border: 1px solid #D9D9D9;
    border-radius: 18px;
    padding: 0px;
}

#modelCard:hover {
    background: #EEF4FF;
    border: 2px solid #3C69F9;
}

#modelImage {
    background: transparent;
    border: none;
    border-radius: 0px;
    margin: 10px 10px 0px 10px;
    padding: 0px;
    qproperty-alignment: AlignCenter;
}

#modelCard:hover #modelImage {
    border-color: #C7D8FF;
}

#modelTitle {
    color: #000000;
    font-size: 18px;
    font-weight: 600;
    margin-left: 18px;
    margin-top: 18px;
}

#modelDescription {
    color: #656A71;
    font-size: 14px;
    line-height: 1.4;
    margin-left: 18px;
    margin-right: 18px;
}

#modelButton {
    background: #3C69F9;
    border: none;
    border-radius: 14px;
    color: #FFFFFF;
    font-size: 18px;
    font-weight: 400;
    min-height: 44px;
    min-width: 190px;
    max-width: 190px;
    padding: 0 8px 0 8px;
    margin: 12px 16px 14px 16px;
    text-align: center;
}

#modelButton QAbstractButton {
    spacing: 8px;
}

#modelButton::icon {
    margin-right: 6px;
}

#modelButton:hover {
    background: #3558FD;
}

#modelButton:pressed {
    background: #2E58E6;
}

#infoPanel {
    background: #EAF2FD;
    border: 1px solid #D4DAE7;
    border-radius: 14px;
    min-height: 74px;
}

#infoText {
    color: #6B7280;
    font-size: 14px;
    line-height: 1.4;
    margin-top: 2px;
    margin-bottom: 2px;
    background: transparent;
}